---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { seoTemplates } from '../../../web/data/seoTemplates';

const industries = [...new Set(seoTemplates.map(t => t.industry))];
---

<BaseLayout title="Free NRS-Compliant Invoice Templates for Nigerian Businesses">
  <div class="max-w-6xl mx-auto py-20 px-6">
    <div class="text-center mb-16">
        <h1 class="text-4xl md:text-6xl font-extrabold text-slate-900 mb-6 tracking-tight">
            Professional <span className="text-teal-600">Invoice Templates</span>
        </h1>
        <p class="text-xl text-slate-600 max-w-2xl mx-auto">
            Free, industry-specific, and fully NRS-compliant templates designed for the 2026 Nigerian tax regime.
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {seoTemplates.map(template => (
            <a 
                href={`/templates/${template.slug}`}
                class="group bg-white p-8 rounded-3xl border border-slate-200 hover:border-teal-500 hover:shadow-2xl hover:shadow-teal-900/10 transition-all duration-300"
            >
                <div class="flex items-center justify-between mb-6">
                    <span class="px-3 py-1 bg-teal-50 text-teal-700 text-[10px] font-bold uppercase tracking-widest rounded-full border border-teal-100">
                        {template.industry}
                    </span>
                    <span class="text-slate-400 group-hover:text-teal-500 transition-colors">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                    </span>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-teal-600 transition-colors">{template.h1}</h3>
                <p class="text-sm text-slate-500 leading-relaxed line-clamp-2">
                    {template.description}
                </p>
                <div class="mt-6 pt-6 border-t border-slate-50 flex items-center gap-2">
                    <div class="flex -space-x-2">
                        {[1,2,3].map(i => <div class="w-6 h-6 rounded-full bg-slate-100 border-2 border-white"></div>)}
                    </div>
                    <span class="text-[10px] font-bold text-slate-400 uppercase">Used by {template.location} SMEs</span>
                </div>
            </a>
        ))}
    </div>

    <div class="mt-20 bg-slate-900 rounded-[3rem] p-12 text-center text-white relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-teal-500/10 rounded-full -mr-32 -mt-32 blur-3xl"></div>
        <div class="relative z-10">
            <h2 class="text-3xl font-bold mb-4">Don't see your industry?</h2>
            <p class="text-slate-400 mb-8 max-w-lg mx-auto">Our AI-powered engine is generating 500+ specialized templates for every Nigerian business sector.</p>
            <a href="/" class="inline-block bg-teal-600 hover:bg-teal-500 text-white font-bold py-4 px-10 rounded-2xl transition-all shadow-xl shadow-teal-900/40">
                Create Custom Invoice Now
            </a>
        </div>
    </div>
  </div>
</BaseLayout>
