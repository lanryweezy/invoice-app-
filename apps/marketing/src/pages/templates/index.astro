---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Free Invoice Templates | Nigeria Business Tools">
  <div class="max-w-4xl mx-auto py-20 px-6 text-center">
    <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-6 tracking-tight">Invoice Templates</h1>
    <p class="text-xl text-slate-600 mb-12">Looking for the perfect invoice template? We're building a collection of 500+ industry-specific templates for Nigerian businesses.</p>
    
    <div class="bg-teal-50 rounded-3xl p-12 border border-teal-100">
        <h2 class="text-2xl font-bold text-teal-900 mb-4">Coming Soon!</h2>
        <p class="text-teal-700 mb-8 max-w-lg mx-auto">We are programmatically generating specialized templates for every industry—from Lagos freelancers to Abuja retailers.</p>
        <a href="/" class="inline-block bg-teal-600 hover:bg-teal-700 text-white font-bold py-3 px-8 rounded-lg transition-colors shadow-lg">
            Back to Invoice Generator
        </a>
    </div>
  </div>
</BaseLayout>
