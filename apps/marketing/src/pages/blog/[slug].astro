---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.data.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const structuredData = {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": entry.data.title,
    "image": [entry.data.imageUrl],
    "datePublished": new Date(entry.data.date).toISOString(),
    "dateModified": new Date(entry.data.date).toISOString(),
    "author": [{
      "@type": "Organization",
      "name": "InvoiceApp.ng",
      "url": "https://invoiceapp.ng"
    }],
    "publisher": {
      "@type": "Organization",
      "name": "InvoiceApp.ng",
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.invoiceapp.ng/favicon.svg"
      }
    },
    "description": entry.data.excerpt
};
---

<BaseLayout 
    title={entry.data.title} 
    description={entry.data.excerpt} 
    image={entry.data.imageUrl} 
    article={true}
>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} slot="head" />

    <div class="w-full pb-16">
      <div class="w-full h-[40vh] min-h-[300px] relative bg-slate-900">
        <img src={entry.data.imageUrl} alt={entry.data.title} class="w-full h-full object-cover opacity-60" />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent"></div>
        <div class="absolute bottom-0 left-0 w-full">
            <div class="max-w-3xl mx-auto px-6 pb-12">
                <a href="/blog" class="inline-flex items-center text-teal-300 hover:text-teal-200 text-sm font-medium mb-6 transition-colors">
                    &larr; Back to Blog
                </a>
                <div class="flex items-center gap-4 text-slate-300 text-sm font-medium mb-4">
                    <span class="bg-teal-500/20 text-teal-200 px-3 py-1 rounded-full border border-teal-500/30">
                        {entry.data.category}
                    </span>
                    <span>{entry.data.readTime}</span>
                    <span>•</span>
                    <span>{entry.data.date}</span>
                </div>
                <h1 class="text-4xl md:text-5xl font-extrabold text-white leading-tight mb-4 tracking-tight">
                    {entry.data.title}
                </h1>
            </div>
        </div>
      </div>

      <div class="max-w-3xl mx-auto px-6 pt-12">
        <div class="prose prose-lg max-w-none prose-slate">
          <p class="lead text-xl text-slate-600 mb-8 font-medium">
              {entry.data.excerpt}
          </p>
          <Content />
        </div>

        <hr class="my-12 border-slate-200" />

        <div class="bg-white rounded-2xl border border-slate-200 p-8 text-center shadow-sm">
            <h3 class="text-2xl font-bold text-slate-800 mb-3">Ready to upgrade your business?</h3>
            <p class="text-slate-600 mb-6">Create professional, automated invoices in seconds. It's 100% free.</p>
            <a href="/" class="inline-block bg-teal-600 hover:bg-teal-700 text-white font-bold py-3 px-8 rounded-lg transition-colors shadow-lg shadow-teal-900/10">
                Create an Invoice Now
            </a>
        </div>
      </div>
    </div>
</BaseLayout>
