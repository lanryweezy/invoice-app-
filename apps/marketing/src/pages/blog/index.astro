---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.reverse();
---

<BaseLayout title="Blog | Business Resources for Nigeria">
  <div class="max-w-4xl mx-auto pt-16 px-4 pb-20">
    <h1 class="text-4xl font-extrabold text-slate-900 mb-4 tracking-tight">InvoiceApp Blog</h1>
    <p class="text-xl text-slate-600 mb-12 font-medium">Resources to build, scale, and optimize your business.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {sortedPosts.map(post => (
        <article class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden hover:shadow-md transition-shadow group flex flex-col h-full cursor-pointer">
          <a href={`/blog/${post.data.slug}`} class="block h-48 overflow-hidden">
            <img src={post.data.imageUrl} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </a>
          <div class="p-6 flex flex-col flex-1">
            <div class="flex items-center justify-between text-xs font-medium text-slate-500 mb-3">
              <span class="bg-slate-100 px-3 py-1 rounded-full text-slate-700">{post.data.category}</span>
              <span>{post.data.readTime}</span>
            </div>
            <a href={`/blog/${post.data.slug}`} class="block mt-2">
              <h3 class="text-xl font-bold text-slate-900 mb-2 leading-tight group-hover:text-teal-600 transition-colors">{post.data.title}</h3>
              <p class="text-slate-600 text-sm line-clamp-3 mb-4">{post.data.excerpt}</p>
            </a>
            <div class="mt-auto pt-4 border-t border-slate-100 flex items-center justify-between">
              <span class="text-sm font-medium text-slate-900 group-hover:text-teal-600 transition-colors">Read Article →</span>
              <span class="text-xs text-slate-500">{post.data.date}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
