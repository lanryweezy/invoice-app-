---
import BaseLayout from '../layouts/BaseLayout.astro';
import { seoTemplates } from '../data/seoTemplates';

const featuredTemplates = seoTemplates.slice(0, 3);
---

<BaseLayout 
  title="InvoiceApp - #1 Free Invoice Generator for Nigerian Freelancers & SMEs"
  description="The most trusted free invoice generator for Nigerian businesses. Stay NRS 2026 compliant with automated VAT/WHT, professional templates, and mobile-first invoicing."
>
  <!-- Hero Section -->
  <section class="relative pt-20 pb-32 overflow-hidden bg-slate-950 text-white">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full overflow-hidden pointer-events-none">
        <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-teal-500/10 rounded-full blur-[120px]"></div>
        <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-blue-500/10 rounded-full blur-[120px]"></div>
    </div>
    
    <div class="max-w-7xl mx-auto px-6 relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-teal-500/10 border border-teal-500/20 text-teal-400 text-xs font-bold uppercase tracking-widest mb-8">
            <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-teal-500"></span>
            </span>
            Built in Lagos for the Nigerian Market
        </div>
        
        <h1 class="text-5xl md:text-7xl font-black mb-8 tracking-tight leading-[1.1]">
            The #1 Free <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-emerald-400">Invoice Generator</span> for Nigeria.
        </h1>
        
        <p class="text-xl md:text-2xl text-slate-400 max-w-3xl mx-auto mb-12 leading-relaxed font-medium">
            Professional, NRS-compliant invoices for freelancers and SMEs. 
            Automated VAT/WHT calculation, instant PDF downloads, and 100% free.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="/editor" class="w-full sm:w-auto px-10 py-5 bg-teal-500 hover:bg-teal-400 text-white font-black text-lg rounded-2xl transition-all shadow-2xl shadow-teal-500/20 transform hover:-translate-y-1">
                Create Your First Invoice
            </a>
            <a href="#features" class="w-full sm:w-auto px-10 py-5 bg-white/5 hover:bg-white/10 text-white font-bold text-lg rounded-2xl transition-all border border-white/10 backdrop-blur-sm">
                Explore Features
            </a>
        </div>
        
        <div class="mt-16 flex flex-wrap justify-center items-center gap-8 grayscale opacity-50">
            <span class="text-xs font-bold uppercase tracking-tighter">NRS Compliant</span>
            <span class="text-xs font-bold uppercase tracking-tighter text-teal-400">NITDA Standards</span>
            <span class="text-xs font-bold uppercase tracking-tighter">FIRS Ready</span>
            <span class="text-xs font-bold uppercase tracking-tighter text-teal-400">CBN Compliant</span>
        </div>
    </div>
  </section>

  <!-- NRS Mandate Section (Urgency/Education) -->
  <section class="py-24 bg-rose-50 border-y border-rose-100 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row items-center gap-16">
        <div class="flex-1">
            <div class="bg-rose-100 text-rose-700 px-4 py-1 rounded-full text-[10px] font-black uppercase tracking-widest mb-6 inline-block">
                Regulatory Alert
            </div>
            <h2 class="text-4xl font-black text-slate-900 mb-6 leading-tight">
                The NRS 2026 Mandate: <br/> Is Your Business Ready?
            </h2>
            <p class="text-lg text-slate-700 mb-8 leading-relaxed">
                By <strong>July 1, 2026</strong>, the Nigeria Revenue Service (NRS) will require all businesses to issue digital, verifiable invoices. Manual paper invoices and basic PDFs will no longer be compliant.
            </p>
            <div class="space-y-4 mb-8">
                <div class="flex items-start gap-4">
                    <div class="bg-rose-200 p-1 rounded-lg mt-1">
                        <svg class="w-4 h-4 text-rose-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                    </div>
                    <p class="text-slate-700 font-medium">Automatic generation of NRS-compliant serial numbers.</p>
                </div>
                <div class="flex items-start gap-4">
                    <div class="bg-rose-200 p-1 rounded-lg mt-1">
                        <svg class="w-4 h-4 text-rose-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                    </div>
                    <p class="text-slate-700 font-medium">Built-in VAT (7.5%) and WHT logic for Nigerian tax laws.</p>
                </div>
                <div class="flex items-start gap-4">
                    <div class="bg-rose-200 p-1 rounded-lg mt-1">
                        <svg class="w-4 h-4 text-rose-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                    </div>
                    <p class="text-slate-700 font-medium">Secure cloud storage for 7-year audit requirements.</p>
                </div>
            </div>
            <a href="/tools/nrs-readiness-assessment" class="text-rose-700 font-black flex items-center gap-2 hover:gap-4 transition-all">
                Take the NRS Readiness Check →
            </a>
        </div>
        <div class="flex-1 bg-white p-8 rounded-[2.5rem] shadow-2xl shadow-rose-900/10 border border-rose-100 rotate-2">
            <div class="space-y-4">
                <div class="h-4 bg-slate-100 rounded-full w-3/4"></div>
                <div class="h-4 bg-slate-100 rounded-full w-1/2"></div>
                <div class="pt-8 space-y-3">
                    <div class="flex justify-between">
                        <span class="text-xs font-bold text-slate-400 uppercase">Subtotal</span>
                        <span class="text-xs font-bold text-slate-900">₦500,000.00</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-xs font-bold text-slate-400 uppercase">VAT (7.5%)</span>
                        <span class="text-xs font-bold text-teal-600">₦37,500.00</span>
                    </div>
                    <div class="flex justify-between border-t pt-3">
                        <span class="text-sm font-black text-slate-900 uppercase">Total Due</span>
                        <span class="text-sm font-black text-slate-900">₦537,500.00</span>
                    </div>
                </div>
                <div class="mt-8 py-3 bg-teal-50 rounded-xl border border-teal-100 text-center">
                    <span class="text-[10px] font-black text-teal-700 uppercase tracking-widest">NRS Compliance Verified</span>
                </div>
            </div>
        </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="py-32 bg-white">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-20">
            <h2 class="text-4xl font-black text-slate-900 mb-6">Designed for Nigerian Business.</h2>
            <p class="text-xl text-slate-500 max-w-2xl mx-auto">We've built everything you need to manage your billing, so you can focus on growing your business.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            <div class="p-8 rounded-3xl bg-slate-50 hover:bg-white border border-slate-100 hover:border-teal-500 hover:shadow-2xl hover:shadow-teal-900/5 transition-all">
                <div class="w-12 h-12 bg-teal-500 text-white rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-teal-500/20">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 4h6m-6 4h6M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                </div>
                <h3 class="text-xl font-black text-slate-900 mb-3">Professional Templates</h3>
                <p class="text-slate-500 text-sm leading-relaxed">Choose from dozens of industry-specific templates designed to impress Nigerian clients.</p>
            </div>

            <div class="p-8 rounded-3xl bg-slate-50 hover:bg-white border border-slate-100 hover:border-teal-500 hover:shadow-2xl hover:shadow-teal-900/5 transition-all">
                <div class="w-12 h-12 bg-blue-500 text-white rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-blue-500/20">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                </div>
                <h3 class="text-xl font-black text-slate-900 mb-3">Mobile-First (PWA)</h3>
                <p class="text-slate-500 text-sm leading-relaxed">Generate and send invoices directly from your phone on the way to a meeting or from the site.</p>
            </div>

            <div class="p-8 rounded-3xl bg-slate-50 hover:bg-white border border-slate-100 hover:border-teal-500 hover:shadow-2xl hover:shadow-teal-900/5 transition-all">
                <div class="w-12 h-12 bg-purple-500 text-white rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-purple-500/20">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                </div>
                <h3 class="text-xl font-black text-slate-900 mb-3">Business Dashboard</h3>
                <p class="text-slate-500 text-sm leading-relaxed">Track which invoices are paid, pending, or overdue. See your total revenue at a glance.</p>
            </div>

            <div class="p-8 rounded-3xl bg-slate-50 hover:bg-white border border-slate-100 hover:border-teal-500 hover:shadow-2xl hover:shadow-teal-900/5 transition-all">
                <div class="w-12 h-12 bg-emerald-500 text-white rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-emerald-500/20">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <h3 class="text-xl font-black text-slate-900 mb-3">Auto VAT/WHT</h3>
                <p class="text-slate-500 text-sm leading-relaxed">Never worry about tax math again. We calculate 7.5% VAT and applicable WHT automatically.</p>
            </div>
        </div>
    </div>
  </section>

  <!-- Template Library Preview -->
  <section class="py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-col md:flex-row items-end justify-between mb-16 gap-6">
            <div class="max-w-2xl">
                <h2 class="text-4xl font-black text-slate-900 mb-4">Templates for Every Industry.</h2>
                <p class="text-lg text-slate-600">From Lagos-based tech startups to Abuja consulting firms, we have the right template for you.</p>
            </div>
            <a href="/templates" class="text-teal-600 font-bold hover:text-teal-700 transition-colors flex items-center gap-2">
                View All 50+ Templates →
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {featuredTemplates.map(template => (
                <a href={`/templates/${template.slug}`} class="group bg-white p-8 rounded-[2rem] border border-slate-200 hover:border-teal-500 transition-all">
                    <span class="text-[10px] font-black uppercase tracking-widest text-teal-600 mb-4 block">{template.industry}</span>
                    <h3 class="text-xl font-bold text-slate-900 mb-4 group-hover:text-teal-600 transition-colors">{template.h1}</h3>
                    <p class="text-sm text-slate-500 mb-6 line-clamp-2">{template.description}</p>
                    <span class="text-xs font-bold text-slate-400 uppercase">Used by {template.location} SMEs</span>
                </a>
            ))}
        </div>
    </div>
  </section>

  <!-- Free Tools Preview -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 text-center">
        <h2 class="text-3xl font-black text-slate-900 mb-12">More Than Just Invoices.</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
            <a href="/tools/vat-calculator" class="p-10 rounded-[2.5rem] bg-teal-50 border border-teal-100 hover:border-teal-500 transition-all text-left group">
                <h3 class="text-2xl font-black text-slate-900 mb-4 group-hover:text-teal-600">VAT & WHT Calculator</h3>
                <p class="text-slate-600 mb-6">Quickly calculate Nigerian VAT and Withholding Tax for any amount.</p>
                <span class="text-teal-600 font-bold uppercase text-xs tracking-widest">Try Tool →</span>
            </a>
            <a href="/tools/nrs-readiness-assessment" class="p-10 rounded-[2.5rem] bg-blue-50 border border-blue-100 hover:border-blue-500 transition-all text-left group">
                <h3 class="text-2xl font-black text-slate-900 mb-4 group-hover:text-blue-600">NRS Readiness Check</h3>
                <p class="text-slate-600 mb-6">Are you compliant with the 2026 mandates? Take our 2-minute audit.</p>
                <span class="text-blue-600 font-bold uppercase text-xs tracking-widest">Audit Business →</span>
            </a>
        </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="py-32 bg-slate-50">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-20">
            <h2 class="text-4xl font-black text-slate-900 mb-4">Simple, Transparent Pricing.</h2>
            <p class="text-xl text-slate-500">The generator is free. Forever.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
            <!-- Free Plan -->
            <div class="p-10 rounded-[3rem] bg-white border-4 border-teal-500 shadow-2xl shadow-teal-900/10 relative overflow-hidden">
                <div class="absolute top-0 right-0 bg-teal-500 text-white px-6 py-2 rounded-bl-3xl text-[10px] font-black uppercase tracking-widest">
                    Available Now
                </div>
                <h3 class="text-2xl font-black text-slate-900 mb-2">Free Plan</h3>
                <p class="text-slate-500 mb-6">For freelancers and growing SMEs.</p>
                <div class="text-4xl font-black text-slate-900 mb-8">₦0 <span class="text-lg text-slate-400 font-medium">/month</span></div>
                
                <ul class="space-y-4 mb-10">
                    <li class="flex items-center gap-3 text-slate-700 font-medium">
                        <svg class="w-5 h-5 text-teal-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                        Unlimited Invoices
                    </li>
                    <li class="flex items-center gap-3 text-slate-700 font-medium">
                        <svg class="w-5 h-5 text-teal-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                        All Professional Templates
                    </li>
                    <li class="flex items-center gap-3 text-slate-700 font-medium">
                        <svg class="w-5 h-5 text-teal-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                        NRS 2026 Compliance
                    </li>
                    <li class="flex items-center gap-3 text-slate-700 font-medium">
                        <svg class="w-5 h-5 text-teal-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                        Mobile App Access
                    </li>
                </ul>
                
                <a href="/editor" class="block text-center py-4 bg-teal-500 hover:bg-teal-400 text-white font-black rounded-2xl transition-all shadow-xl shadow-teal-500/20">
                    Start Creating Free
                </a>
            </div>

            <!-- Pro Plan (Coming Soon) -->
            <div class="p-10 rounded-[3rem] bg-slate-100 border border-slate-200 opacity-80 group">
                <h3 class="text-2xl font-black text-slate-900 mb-2">Pro Plan</h3>
                <p class="text-slate-500 mb-6">For teams and high-volume businesses.</p>
                <div class="text-4xl font-black text-slate-400 mb-8">TBA <span class="text-lg text-slate-400 font-medium">/month</span></div>
                
                <ul class="space-y-4 mb-10 text-slate-500">
                    <li class="flex items-center gap-3">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                        Everything in Free
                    </li>
                    <li class="flex items-center gap-3">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                        Multi-user Teams
                    </li>
                    <li class="flex items-center gap-3">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                        Advanced Business Analytics
                    </li>
                    <li class="flex items-center gap-3">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                        Custom API Integration
                    </li>
                </ul>
                
                <div class="text-center py-4 bg-slate-200 text-slate-500 font-black rounded-2xl cursor-not-allowed">
                    Coming Soon
                </div>
            </div>
        </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 bg-teal-600 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-white via-transparent to-transparent"></div>
    </div>
    <div class="max-w-4xl mx-auto px-6 text-center relative z-10">
        <h2 class="text-4xl md:text-5xl font-black text-white mb-8">Ready to Professionalize Your Invoicing?</h2>
        <p class="text-xl text-teal-50 mb-12">Join thousands of Nigerian freelancers and SMEs already using InvoiceApp to get paid faster.</p>
        <a href="/editor" class="inline-block px-12 py-6 bg-white text-teal-600 font-black text-xl rounded-2xl hover:bg-teal-50 transition-all shadow-2xl">
            Create Your First Invoice Now
        </a>
    </div>
  </section>
</BaseLayout>
