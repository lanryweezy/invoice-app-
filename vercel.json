{
  "rewrites": [
    {
      "source": "/blog/:match*",
      "destination": "/marketing/blog/:match*"
    },
    {
      "source": "/blog",
      "destination": "/marketing/blog/"
    },
    {
      "source": "/templates/:match*",
      "destination": "/marketing/templates/:match*"
    },
    {
      "source": "/templates",
      "destination": "/marketing/templates/"
    },
    {
      "source": "/tools/:match*",
      "destination": "/marketing/tools/:match*"
    },
    {
      "source": "/tools",
      "destination": "/marketing/tools/"
    },
    {
      "source": "/nrs-compliance-dossier",
      "destination": "/marketing/nrs-compliance-dossier/"
    },
    {
      "source": "/editor",
      "destination": "/web/editor"
    },
    {
      "source": "/(.*)",
      "destination": "/web/$1"
    }
  ]
}