{
  "installCommand": "pnpm install --no-frozen-lockfile",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/blog", "destination": "/marketing/blog/" },
    { "source": "/blog/:match*", "destination": "/marketing/blog/:match*" },
    { "source": "/templates", "destination": "/marketing/templates/" },
    { "source": "/templates/:match*", "destination": "/marketing/templates/:match*" },
    { "source": "/tools", "destination": "/marketing/tools/" },
    { "source": "/tools/:match*", "destination": "/marketing/tools/:match*" },
    { "source": "/nrs-compliance-dossier", "destination": "/marketing/nrs-compliance-dossier/" },
    { "source": "/_astro/:match*", "destination": "/marketing/_astro/:match*" },
    { "source": "/favicon.svg", "destination": "/marketing/favicon.svg" },
    { "source": "/web/:match*", "destination": "/web/:match*" },
    { "source": "/(.*)", "destination": "/web/index.html" }
  ]
}
